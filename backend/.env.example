# Deepgram STT
DEEPGRAM_API_KEY=""

# Active telephony provider: twilio or exotel
TELEPHONY_PROVIDER="exotel"

# Exotel Account Capabilities
# Note: Voicebot Applet / AgentStream is an enterprise feature not enabled on default trial tiers.
# Keep false until confirmed enabled by Exotel support.
EXOTEL_STREAMING_ENABLED="False"

# News API (NewsAPI.org) for real-time news retrieval
# Get a free key at https://newsapi.org/
NEWS_API_KEY=""
NEWS_API_BASE_URL="https://newsapi.org/v2"
NEWS_COUNTRY="in"

# Exotel Voice Agent Custom API Integration Authentication
# Set a strong random secret to secure /api/v1/voice-agent/ask
VOICE_AGENT_API_KEY="your-voice-agent-secret-key-here"
